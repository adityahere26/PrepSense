datasource db {
  provider = "postgresql"    
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String             @id @default(cuid())
  email          String             @unique
  name           String?
  picture        String?
  googleId       String?            @unique
  targetRole     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  resumes        Resume[]
  sessions       InterviewSession[]
  successStories SuccessStory[]
}

model Resume {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl    String
  parsedJson String             // Stores JSON stringified data in SQLite
  version    Int                @default(1)
  createdAt  DateTime           @default(now())
  analyses   Analysis[]
  sessions   InterviewSession[]
}

model Analysis {
  id           String   @id @default(cuid())
  resumeId     String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jdText       String?
  atsScore     Int
  matchScore   Int?
  feedbackJson String   // Stores JSON stringified data in SQLite
  createdAt    DateTime @default(now())
}

model InterviewSession {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId    String?
  resume      Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  targetRole  String
  status      String              @default("in_progress") // in_progress | completed
  summaryJson String?             // Stores JSON stringified data in SQLite
  createdAt   DateTime            @default(now())
  completedAt DateTime?
  questions   InterviewQuestion[]
}

model InterviewQuestion {
  id           String           @id @default(cuid())
  sessionId    String
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order        Int
  category     String
  questionText String
  answer       InterviewAnswer?
}

model InterviewAnswer {
  id             String            @id @default(cuid())
  questionId     String            @unique
  question       InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  transcript     String
  evaluationJson String            // Stores JSON stringified data in SQLite
  scoreOverall   Int
  createdAt      DateTime          @default(now())
}

model SuccessStory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName   String
  roleAchieved String?
  content      String
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String
  summary   String
  content   String
  createdAt DateTime @default(now())
}
